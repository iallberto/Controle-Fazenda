# Variáveis de produção (spec 007). No servidor, copie para .env e preencha:
#   cp .env.producao.example .env && nano .env
# O .env nunca vai para o repositório. Roteiro: docs/publicacao/Roteiro-de-publicacao.md

# --- Endereço ---------------------------------------------------------------
# Domínio do sistema, sem https:// (ex.: app.controlefazenda.com.br).
# O Caddy pede o certificado sozinho quando o domínio já aponta para este servidor.
DOMINIO=localhost

# --- Banco de dados ---------------------------------------------------------
DB_USERNAME=postgres
# Senha longa e aleatória. Gere com:  openssl rand -base64 32
DB_PASSWORD=troque-esta-senha

# --- Login -------------------------------------------------------------------
# Segredo que assina os logins. Longo e aleatório; trocar derruba todas as sessões.
# Gere com:  openssl rand -base64 48
JWT_SECRET=troque-este-segredo

# --- Backup na nuvem -----------------------------------------------------------
# Bucket S3 compatível (sugestão: Backblaze B2, 10 GB grátis). Formato:
#   nuvem:<nome-do-bucket>/controle-fazenda
# Vazio = backup só neste servidor (não use assim em produção).
BACKUP_REMOTO=
# Provedor para o rclone: Other serve para Backblaze B2; Cloudflare para R2; AWS para S3.
BACKUP_S3_PROVEDOR=Other
# Endpoint S3 do bucket (no B2 aparece na página do bucket, ex.: https://s3.us-east-005.backblazeb2.com)
BACKUP_S3_ENDPOINT=
# Chave de aplicação com acesso só a este bucket
BACKUP_S3_CHAVE=
BACKUP_S3_SEGREDO=

# --- Monitoramento -------------------------------------------------------------
# URL de ping do Healthchecks.io (verificação diária, tolerância 2 h).
# O backup chama esta URL no sucesso e <URL>/fail no erro.
BACKUP_AVISO_URL=
