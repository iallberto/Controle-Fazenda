# Copie para .env e troque os valores
JWT_SECRET=uma-frase-bem-longa-e-dificil-de-adivinhar-aqui
DB_USERNAME=postgres
DB_PASSWORD=troque-esta-senha
# true só em desenvolvimento: cria/altera as tabelas a partir das entidades
DB_SYNCHRONIZE=true
# false em produção para esconder a documentação em /docs
SWAGGER_ENABLED=true
CORS_ORIGINS=http://localhost:8080
